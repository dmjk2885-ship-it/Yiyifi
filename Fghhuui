-- // สร้างโดย AI สำหรับคุณ (GKHub Camera Lock)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local locked = false

-- // สร้าง ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GKHub_CameraLock"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-- // ปุ่มกด (UI แบบโปร่งใส ไม่เกะกะ)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleButton"
toggleBtn.Size = UDim2.new(0, 45, 0, 45) -- ขนาดเล็กกำลังดีสำหรับมือถือ
toggleBtn.Position = UDim2.new(0.85, 0, 0.15, 0) -- อยู่มุมขวาบน ไม่บังจอหลัก
toggleBtn.AnchorPoint = Vector2.new(0.5, 0.5)
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
toggleBtn.BackgroundTransparency = 0.6 -- ความจางของพื้นหลัง
toggleBtn.Text = "GK"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextTransparency = 0.3 -- ความจางของตัวหนังสือ
toggleBtn.TextSize = 14
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.Parent = screenGui

-- // ทำให้ปุ่มมีความโค้งมนสวยงาม
local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(1, 0) -- วงกลม
uiCorner.Parent = toggleBtn

-- // ข้อความบอกชื่อค่ายเล็กๆ ใต้ปุ่ม (จางๆ)
local creditLabel = Instance.new("TextLabel")
creditLabel.Size = UDim2.new(0, 60, 0, 15)
creditLabel.Position = UDim2.new(0, -7, 1, 2)
creditLabel.BackgroundTransparency = 1
creditLabel.Text = "GKHub"
creditLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
creditLabel.TextTransparency = 0.5
creditLabel.TextSize = 10
creditLabel.Font = Enum.Font.Gotham
creditLabel.Parent = toggleBtn

-- // ฟังก์ชันการทำงานปุ่มเปิด-ปิด
toggleBtn.MouseButton1Click:Connect(function()
	locked = not locked
	if locked then
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255) -- เปลี่ยนเป็นสีฟ้าจางๆ เมื่อเปิด
		toggleBtn.BackgroundTransparency = 0.4
	else
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- กลับเป็นสีดำจางๆ เมื่อปิด
		toggleBtn.BackgroundTransparency = 0.6
	end
end)

-- // ล็อกมุมกล้อง (ล็อคทิศทางตัวละครให้หมุนตามมุมกล้องตลอดเวลา)
RunService.RenderStepped:Connect(function()
	if locked and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local humanoidRootPart = player.Character.HumanoidRootPart
		-- บังคับให้หน้าตัวละครหันไปทางเดียวกับกล้อง
		humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position, Vector3.new(camera.CFrame.LookVector.X * 9999, humanoidRootPart.Position.Y, camera.CFrame.LookVector.Z * 9999))
	end
end)
