-- // ฟังก์ชันการทำงานเปิด-ปิด ล็อคมุมกล้อง
toggleBtn.MouseButton1Click:Connect(function()
	locked = not locked
	if locked then
		lockedCFrame = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable
		
		toggleBtn.Text = "ล็อคมุมกล้อง: เปิด"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
		toggleBtn.BackgroundTransparency = 0.4
		toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		camera.CameraType = Enum.CameraType.Custom
		lockedCFrame = nil
		
		toggleBtn.Text = "ล็อคมุมกล้อง: ปิด"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		toggleBtn.BackgroundTransparency = 0.6
		toggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	end
end)

-- // ล็อกมุมกล้องให้อยู่กับที่ตลอดเวลาที่เปิดใช้งาน
RunService.RenderStepped:Connect(function()
	if locked and lockedCFrame then
		camera.CFrame = lockedCFrame
	end
end)
