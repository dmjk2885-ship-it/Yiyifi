-- // สร้างโดย AI สำหรับคุณ (GKHub Camera Free-Lock)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local locked = false
local lockedCFrame = nil

-- // สร้าง ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GKHub_CameraStaticLock"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-- // ปุ่มกด (UI แบบโปร่งใส ไม่เกะกะ)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleButton"
toggleBtn.Size = UDim2.new(0, 45, 0, 45) -- ขนาดเล็กกำลังดีสำหรับมือถือ
toggleBtn.Position = UDim2.new(0.85, 0, 0.15, 0) -- อยู่มุมขวาบน
toggleBtn.AnchorPoint = Vector2.new(0.5, 0.5)
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
toggleBtn.BackgroundTransparency = 0.6 -- ความจางของพื้นหลัง
toggleBtn.Text = "GK"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextTransparency = 0.3 -- ความจางของตัวหนังสือ
toggleBtn.TextSize = 14
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.Parent = screenGui

-- // ทำให้ปุ่มโค้งมน
local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(1, 0)
uiCorner.Parent = toggleBtn

-- // ชื่อค่ายใต้ปุ่มแบบจางๆ
local creditLabel = Instance.new("TextLabel")
creditLabel.Size = UDim2.new(0, 60, 0, 15)
creditLabel.Position = UDim2.new(0, -7, 1, 2)
creditLabel.BackgroundTransparency = 1
creditLabel.Text = "GKHub"
creditLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
creditLabel.TextTransparency = 0.5
creditLabel.TextSize = 10
creditLabel.Font = Enum.Font.Gotham
creditLabel.Parent = toggleBtn

-- // ฟังก์ชันเปิด-ปิด ล็อกมุมกล้อง
toggleBtn.MouseButton1Click:Connect(function()
	locked = not locked
	if locked then
		-- บันทึกตำแหน่งและมุมมองของกล้อง ณ ปัจจุบันที่กด
		lockedCFrame = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable -- เปลี่ยนโหมดกล้องให้ผู้เล่นคุมไม่ได้
		
		-- เปลี่ยนสีปุ่มให้รู้ว่าเปิดอยู่ (สีฟ้าจางๆ)
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
		toggleBtn.BackgroundTransparency = 0.4
	else
		-- คืนค่ากล้องกลับเป็นปกติ
		camera.CameraType = Enum.CameraType.Custom
		lockedCFrame = nil
		
		-- กลับเป็นสีเดิม
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		toggleBtn.BackgroundTransparency = 0.6
	end
end)

-- // ล็อกมุมกล้องให้อยู่กับที่ตลอดเวลาที่เปิดใช้งาน
RunService.RenderStepped:Connect(function()
	if locked and lockedCFrame then
		camera.CFrame = lockedCFrame
	end
end)
