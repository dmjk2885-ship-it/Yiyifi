-- // สร้างโดย AI สำหรับคุณ (GKHub - ล็อคมุมกล้อง พร้อมหน้าจอโหลดและคัดลอกลิงก์)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local locked = false
local lockedCFrame = nil

-- // ฟังก์ชันสำหรับคัดลอกข้อความ (รองรับระบบ Executor ในมือถือส่วนใหญ่)
local function copyToClipboard(text)
	if setclipboard then
		setclipboard(text)
	elseif syn and syn.write_clipboard then
		syn.write_clipboard(text)
	elseif Clipboard and Clipboard.set then
		Clipboard.set(text)
	end
end

-- // สร้าง ScreenGui หลัก
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GKHub_CameraLockGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-------------------------------------------------------------------
-- // 1. ส่วนของหน้าจอโหลด (Loading Screen)
-------------------------------------------------------------------
local loadFrame = Instance.new("Frame")
loadFrame.Name = "LoadFrame"
loadFrame.Size = UDim2.new(0, 200, 0, 70)
loadFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
loadFrame.AnchorPoint = Vector2.new(0.5, 0.5)
loadFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
loadFrame.BackgroundTransparency = 0.3
loadFrame.BorderSizePixel = 0
loadFrame.Parent = screenGui

local loadCorner = Instance.new("UICorner")
loadCorner.CornerRadius = UDim.new(0, 10)
loadCorner.Parent = loadFrame

local loadText = Instance.new("TextLabel")
loadText.Size = UDim2.new(1, 0, 1, 0)
loadText.BackgroundTransparency = 1
loadText.Text = "กำลังดาวโหลด..."
loadText.TextColor3 = Color3.fromRGB(255, 255, 255)
loadText.TextSize = 13
loadText.Font = Enum.Font.GothamBold
loadText.Parent = loadFrame

-- // อニメーション กำลังดาวโหลด... (2 วินาที)
task.spawn(function()
	local dots = {"", ".", "..", "..."}
	local startTime = tick()
	
	-- ช่วงที่ 1: กำลังดาวโหลด (2 วินาที)
	while tick() - startTime < 2 do
		for i = 1, #dots do
			if tick() - startTime >= 2 then break end
			loadText.Text = "กำลังดาวโหลด" .. dots[i]
			task.wait(0.3)
		end
	end
	
	-- ช่วงที่ 2: คัดลอกดิสเสร็จแล้ว (คัดลอกลิงก์อัตโนมัติ และแสดง 1.5 วินาที)
	loadText.Text = "คัดลอกดิสเสร็จแล้ว!"
	copyToClipboard("https://discord.gg/Ugssja4wqQ")
	task.wait(1.5)
	
	-- ค่อยๆ เฟดหน้าจอโหลดหายไป
	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local fadeOut = TweenService:Create(loadFrame, tweenInfo, {BackgroundTransparency = 1})
	local textFadeOut = TweenService:Create(loadText, tweenInfo, {TextTransparency = 1})
	
	fadeOut:Play()
	textFadeOut:Play()
	
	fadeOut.Completed:Connect(function()
		loadFrame:Destroy()
	end)
end)

